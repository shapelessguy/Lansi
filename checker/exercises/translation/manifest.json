{
    "title": "Translate",
    "description": "Translate sentences that need the lesson into the language you learn, or from it, or whole texts, such as short stories, where a brief gives them. Each instance is a set of them, checked together.",
    "sentence_checks": "optional",
    "options": {
        "direction": {
            "label": "Direction",
            "about": "which way the learner translates at first, which they may turn while they do it: into the language learned, practising its grammar, or from it, practising reading it",
            "choices": {
                "into": "Into the language you learn",
                "from": "From the language you learn"
            }
        },
        "sentences": {
            "label": "Sentences in a set",
            "about": "how many items a set has: sentences, or whole texts, such as short stories, where the brief gives texts; three stories in one set are 3, and ten sentences 10",
            "min": 1,
            "max": 20,
            "default": 5
        }
    },
    "instance": {
        "type": "object",
        "description": "a set of sentences to translate, shown and judged together",
        "properties": {
            "items": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string",
                            "description": "the sentence to translate, in the language the learner reads"
                        },
                        "reference": {
                            "type": "string",
                            "description": "a right translation of it, in the language learned"
                        }
                    },
                    "required": [
                        "source",
                        "reference"
                    ]
                }
            }
        },
        "required": [
            "items"
        ]
    },
    "preview": [
        "items.*.source"
    ],
