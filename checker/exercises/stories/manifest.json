{
    "title": "Stories",
    "description": "Read a short story written for the lesson and the topic, and listen to it, then answer questions on it or retell it. Each instance is a story.",
    "options": {
        "then": {
            "label": "Then",
            "choices": {
                "questions": "Answer questions",
                "retell": "Retell it",
                "read": "Just read it"
            }
        },
        "questions": {
            "label": "Questions on a story",
            "min": 1,
            "max": 8,
            "default": 3
        },
        "length": {
            "label": "Length of a story",
            "choices": {
                "level": "For my level",
                "shorter": "Shorter",
                "longer": "Longer"
            }
        }
    },
    "instance": {
        "type": "object",
        "description": "a story, with its questions when they are asked",
        "properties": {
            "title": {
                "type": "string"
            },
            "text": {
                "type": "string"
            },
            "questions": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "question": {
                            "type": "string"
                        },
                        "answer": {
                            "type": "string",
                            "description": "what the model meant to be answered"
                        }
                    },
                    "required": [
                        "question",
                        "answer"
                    ]
                }
            }
        },
        "required": [
            "title",
            "text"
        ]
    }
}
