{
    "title": "Fill the gaps",
    "description": "Fill in the gaps of sentences that practise the lesson. Each instance is a set of sentences, checked together.",
    "options": {
        "sentences": {
            "label": "Sentences in a set",
            "min": 1,
            "max": 10,
            "default": 5
        }
    },
    "instance": {
        "type": "object",
        "description": "a set of sentences, shown and checked together",
        "properties": {
            "items": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "text": {
                            "type": "string",
                            "description": "the sentence, with each gap in brackets and the answers it takes joined by |"
                        },
                        "hints": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "a hint for each gap, empty for none"
                        },
                        "translation": {
                            "type": "string",
                            "description": "the sentence in the language the learner reads"
                        }
                    },
                    "required": [
                        "text",
                        "hints",
                        "translation"
                    ]
                }
            }
        },
        "required": [
            "items"
        ]
    },
