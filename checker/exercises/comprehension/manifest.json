{
    "title": "Understand a text",
    "description": "Read a text, or listen to it, and answer questions on it by choosing: a, b or c, right or wrong, or what goes with what. Each instance is a text with its questions.",
    "options": {
        "by": {
            "label": "By",
            "choices": {
                "reading": "Reading it",
                "listening": "Listening to it"
            }
        },
        "text": {
            "label": "Kind of text",
            "choices": {
                "any": "Any that fits",
                "message": "An email or a letter",
                "article": "A newspaper article",
                "adverts": "Adverts or notices",
                "signs": "Signs and boards",
                "dialogue": "A conversation",
                "announcement": "An announcement",
                "phone": "A message on the phone",
                "interview": "An interview"
            }
        },
        "answers": {
            "label": "Answers",
            "choices": {
                "choice": "a, b or c",
                "truefalse": "Richtig or Falsch",
                "yesno": "Ja or Nein",
                "match": "Match to a list"
            }
        },
        "questions": {
            "label": "Questions on a text",
            "min": 1,
            "max": 10,
            "default": 3
        },
        "plays": {
            "label": "Heard",
            "choices": {
                "2": "Twice",
                "1": "Once",
                "0": "As often as I like"
            }
        }
    },
    "instance": {
        "type": "object",
        "description": "a text to understand, with its questions",
        "properties": {
            "title": {
                "type": "string",
                "description": "its title, or empty"
            },
            "shown": {
                "type": "string",
                "description": "what goes with it to be read all along, such as a list to match, or empty"
            },
            "text": {
                "type": "string",
                "description": "the text, read or heard"
            },
            "questions": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "prompt": {
                            "type": "string"
                        },
                        "options": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "answer": {
                            "type": "integer",
                            "description": "the place of the right option, from 0"
                        }
                    },
                    "required": [
                        "prompt",
                        "options",
                        "answer"
                    ]
                }
            }
        },
        "required": [
            "title",
            "shown",
            "text",
            "questions"
        ]
    }
}
