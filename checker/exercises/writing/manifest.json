{
    "title": "Write",
    "description": "Write a short message, an email or a post on a situation, to every point it asks for, or fill in a form from a text; what you write is rated as an exam rates it. Each instance is a task.",
    "options": {
        "kind": {
            "label": "What to write",
            "choices": {
                "message": "A message to a friend",
                "email": "An email with Sie",
                "opinion": "An opinion, as in a forum",
                "form": "A form, filled in from a text"
            }
        },
        "words": {
            "label": "About how many words",
            "min": 20,
            "max": 250,
            "default": 40
        }
    },
    "instance": {
        "type": "object",
        "description": "a task of writing: a situation with the points to write about, or a text with the fields of a form to fill in from it",
        "properties": {
            "kind": {
                "type": "string",
                "enum": [
                    "message",
                    "email",
                    "opinion",
                    "form"
                ]
            },
            "situation": {
                "type": "string"
            },
            "points": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "text": {
                "type": "string",
                "description": "what a form is filled in from"
            },
            "fields": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "label": {
                            "type": "string"
                        },
                        "answer": {
                            "type": "string",
                            "description": "what the text says goes in it"
                        }
                    },
                    "required": [
                        "label",
                        "answer"
                    ]
                }
            }
        },
        "required": [
            "kind"
        ]
    },
